{
  "name": "ge-workbench-electric-safety",
  "version": "0.2.0",
  "description": "用电安全助手：每日拉取能源管理系统 AI 自检报告，汇总异常租户并展示用电曲线",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "BaiXiaoBai-Zcx (https://github.com/Zcx-BaixiaoBai)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zcx-BaixiaoBai/ge-workbench-electric-safety"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0"
  },
  "scripts": {
    "build": "esbuild src/entry.jsx --bundle --format=iife --target=es2022 --outfile=lib/client.js --jsx-factory=h",
    "test": "node --test test/server.test.mjs test/client.test.mjs test/render.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
